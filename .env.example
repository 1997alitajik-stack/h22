# ============================================================================
# RASTA environment configuration — copy to .env.local.
# The URL and publishable key below are public client configuration.
# Publishable keys are designed to be exposed; protect data with correct RLS.
# NEVER commit .env.local, service-role/secret keys, or setup tokens.
# ============================================================================

# Supabase project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://drldexujprdudaphdyzn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QXyHpeztQV5Z9pdIAwR0uw_m7iNYZH0

# Optional compatibility fallback for older deployments that still use the legacy anon key.
# The code prefers NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY when both are set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Server-only secret — must never be exposed to the browser or committed with a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time bootstrap token for creating the first administrator at /setup.
# Generate a strong random value (e.g. `node -e "console.log(crypto.randomUUID())"`).
# Set a real value locally/Vercel only; never commit the actual token.
# After the first admin exists, /setup refuses to run regardless of this value.
RASTA_SETUP_TOKEN=generate-a-strong-random-token
