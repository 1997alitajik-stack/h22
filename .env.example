# ============================================================================
# RASTA environment configuration — copy to .env.local and fill real values.
# NEVER commit .env.local or any file containing real keys.
# ============================================================================

# Supabase project → Settings → API
# Safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=hNEXT_PUBLIC_SUPABASE_URL=https://drldexujprdudaphdyzn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QXyHpeztQV5Z9pdIAwR0uw_m7iNYZH0
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time bootstrap token for creating the first administrator at /setup.
# Generate a strong random value (e.g. `node -e "console.log(crypto.randomUUID())"`).
# After the first admin exists, /setup refuses to run regardless of this value.
RASTA_SETUP_TOKEN=generate-a-strong-random-token
